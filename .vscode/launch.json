{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: uvicorn (conda)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--host", "0.0.0.0",
        "--port", "5000"
      ],
      "jinja": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}/src",
      "python": "${command:python.interpreterPath}"
    }
  ]
}